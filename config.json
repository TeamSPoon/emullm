 "agents": [
  {
   "kind": "agent",
   "id": "alice",
   "launch": "subagent",
   "description": "Auto-configured Copilot worker (spawned only when mode includes 'auto').",
   "role": "trusted",
   "command": "copilot",
   "cwd": "subagents/alice",
   "services": {
    "chat": "serve",
    "embeddings": "stub",
    "images": {
     "behavior": "error",
     "description": "alice does not draw"
    }
   },
   "model": "gpt-5.4"
  },
  {
   "kind": "agent",
   "id": "bob",
   "launch": "recruit",
   "description": "Interactive recruit -- a human-driven Copilot that connects itself.",
   "role": "trusted",
   "observe": [
    "chat"
   ],
   "services": {
    "chat": "serve"
   }
  },
  {
   "kind": "agent",
   "id": "carol",
   "enabled": false,
   "launch": "mock",
   "description": "Deterministic fake used for offline testing. if carol moks here then that means we pretend carol impomented or error or whatever",
   "role": "mock",
   "reply": "hi from carol",
   "template": "carol says: {prompt}",
   "capabilities": [
    "images"
   ],
   "models": {
    "same": {
     "display_name": "carol (mock)"
    }
   },
   "services": {
    "chat": "serve"
   }
  },
  {
