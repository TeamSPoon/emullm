{
 "description": "emullm dev config -- exercises every schema key offline (no network, no real processes).",
 "mode": "recruit,mock",
 "validation_interval_default": "never",
 "validation_interval": null,
 "validation_interval_override": null,
 "subagent_launch": "copilot",
 "capability_fallback": "stub",
 "services": {
  "embeddings": {
   "fallback": "stub",
   "description": "Deterministic pseudo-vectors -- never real embeddings."
  },
  "images": {
   "fallback": "error",
   "description": "Not offered here -- the backend has no image models."
  },
  "moderations": {
   "fallback": "stub",
   "description": "Never flags unless an agent opts in."
  },
  "audio": {
   "fallback": "stub",
   "description": "Synthetic/stub audio unless an agent opts in."
  },
  "model": "google/gemma-4-31b-it",
  "models": [
   "google/gemma-4-31b-it",
   "openai/gpt-oss-20b",
   "myself/same"
  ]
 },
 "agents": [
  {
   "kind": "agent",
   "id": "alice",
   "launch": "subagent",
   "description": "Auto-configured Copilot worker (spawned only when mode includes 'auto').",
   "role": "trusted",
   "command": "copilot",
   "cwd": "subagents/alice",
   "services": {
    "chat": "serve",
    "embeddings": "stub",
    "images": {
     "behavior": "error",
     "description": "alice does not draw"
    }
   },
   "model": "gpt-5.4"
  },
  {
   "kind": "agent",
   "id": "bob",
   "launch": "recruit",
   "description": "Interactive recruit -- a human-driven Copilot that connects itself.",
   "role": "trusted",
   "observe": [
    "chat"
   ],
   "services": {
    "chat": "serve"
   }
  },
  {
   "kind": "agent",
   "id": "carol",
   "launch": "mock",
   "description": "Deterministic fake used for offline testing. if carol moks here then that means we pretend carol impomented or error or whatever",
   "role": "mock",
   "reply": "hi from carol",
   "template": "carol says: {prompt}",
   "capabilities": [
    "images"
   ],
   "models": {
    "same": {
     "display_name": "carol (mock)"
    }
   },
   "services": {
    "chat": "serve"
   }
  },
  {
   "kind": "agent",
   "id": "openai",
   "launch": "proxy",
   "name": "snet",
   "validation_interval": "1week",
   "description": "Real OpenAI-compatible upstream (used only when mode includes 'proxy').",
   "base_url": "https://llm.c.singularitynet.io/v1",
   "api_key_env": "SNET_API_KEY",
   "api_key": null,
   "model": "google/gemma-4-31b-it",
   "default": true,
   "services": {
    "chat": {
     "behavior": "aggregate",
     "strategy": "failover",
     "catalog": [
      "google/gemma-4-26b-a4b-it",
